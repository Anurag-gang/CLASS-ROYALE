    "ml:start": "cd ml-service && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "postinstall": "node -e \"const fs=require('fs'); ['node_modules/three/build/three.module.js'].forEach(p=>{if(fs.existsSync(p)){let f=fs.readFileSync(p,'utf8');if(!f.includes('sRGBEncoding')){f+='\\nexport const sRGBEncoding = 3001;\\nexport const LinearEncoding = 3000;\\n';fs.writeFileSync(p,f);}}}); ['node_modules/three/build/three.cjs'].forEach(p=>{if(fs.existsSync(p)){let f=fs.readFileSync(p,'utf8');if(!f.includes('sRGBEncoding')){f+='\\nexports.sRGBEncoding = 3001;\\nexports.LinearEncoding = 3000;\\n';fs.writeFileSync(p,f);}}});\""
  },
