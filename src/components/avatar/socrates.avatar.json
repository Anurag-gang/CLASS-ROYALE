      "type": "sphere",
      "width": 220,
      "height": 230,
      "depth": 210,
      "roundness": 0.95
    },
    "nodes": [
      {
        "surface": {
          "type": "cone",
          "width": 140,
          "height": 80,
          "depth": 100,
          "roundness": 0.5,
          "tipRoundness": 0.4,
          "baseRoundness": 0.3
        },
        "position": [0, -85, 30],
        "rotation": [10, 0, 0]
      },
      {
        "surface": {
          "type": "cylinder",
          "width": 190,
          "height": 28,
          "depth": 190,
          "roundness": 0.8
        },
        "position": [0, 95, 0],
        "rotation": [-5, 0, 0]
      }
    ]
  },
  "colors": {
    "body": "#ede6f6",
    "eyes": "#1e0836"
  },
  "expressions": {
    "neutral": {
      "head": { "x": 0, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 14, "height": 20, "x": -38, "y": 15, "angle": 0 },
        "right": { "width": 14, "height": 20, "x": 38, "y": 15, "angle": 0 },
        "spacing": 76
      },
      "perspective": 1,
      "motion": { "eyes": "microSaccades", "body": "slowDrift" }
    },
    "thinking": {
      "head": { "x": 8, "y": 12, "z": -5 },
      "eyes": {
        "left": { "width": 12, "height": 14, "x": -35, "y": 26, "angle": 10 },
        "right": { "width": 16, "height": 22, "x": 42, "y": 28, "angle": 5 },
        "spacing": 77
      },
      "perspective": 1.1,
      "motion": { "eyes": "microSaccades", "body": "slowDrift" },
      "colors": { "eyes": "#00ffcc" }
    },
    "speaking": {
      "head": { "x": 0, "y": -4, "z": 2 },
      "eyes": {
        "left": { "width": 16, "height": 24, "x": -38, "y": 16, "angle": -2 },
        "right": { "width": 16, "height": 24, "x": 38, "y": 16, "angle": 2 },
        "spacing": 76
      },
      "perspective": 1,
      "motion": { "eyes": "microSaccades", "body": "shake" },
      "colors": { "eyes": "#f755bc" }
    },
    "inquiry": {
      "head": { "x": -6, "y": 6, "z": 4 },
      "eyes": {
        "left": { "width": 18, "height": 22, "x": -36, "y": 20, "angle": -5 },
        "right": { "width": 14, "height": 18, "x": 38, "y": 18, "angle": 8 },
        "spacing": 74
      },
      "perspective": 1.05,
      "motion": { "eyes": "microSaccades", "body": "slowDrift" },
      "colors": { "eyes": "#facc15" }
    },
    "sleeping": {
      "head": { "x": -4, "y": -15, "z": 0 },
      "eyes": {
        "left": { "width": 18, "height": 4, "x": -38, "y": 6, "angle": 0 },
        "right": { "width": 18, "height": 4, "x": 38, "y": 6, "angle": 0 },
        "spacing": 76
      },
      "perspective": 0.95,
      "motion": { "eyes": "none", "body": "slowDrift" }
    }
