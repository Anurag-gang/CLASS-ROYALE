  "expressionOrder": ["neutral", "thinking", "speaking", "inquiry", "sleeping"],
  "animations": {
    "idle": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "neutral", "holdMs": 3000, "transitionMs": 600, "transition": "smooth" },
        { "expression": "thinking", "holdMs": 1800, "transitionMs": 500, "transition": "smooth" },
        { "expression": "neutral", "holdMs": 2500, "transitionMs": 600, "transition": "smooth" }
      ],
      "blink": {
        "enabled": true,
        "initialDelayMs": 1000,
        "minIntervalMs": 2200,
        "maxIntervalMs": 4500,
        "durationMs": 160
      },
      "metadata": { "label": "Socrates Idle Pondering", "group": "default" }
    },
    "thinking": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "thinking", "holdMs": 1500, "transitionMs": 400, "transition": "snappy" },
        { "expression": "inquiry", "holdMs": 800, "transitionMs": 350, "transition": "smooth" }
      ],
      "blink": {
        "enabled": true,
        "initialDelayMs": 500,
        "minIntervalMs": 1800,
        "maxIntervalMs": 3500,
        "durationMs": 140
      },
      "metadata": { "label": "Socrates Deep Contemplation", "group": "interaction" }
    },
    "speaking": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "speaking", "holdMs": 350, "transitionMs": 180, "transition": "snappy" },
        { "expression": "neutral", "holdMs": 200, "transitionMs": 150, "transition": "snappy" },
        { "expression": "speaking", "holdMs": 400, "transitionMs": 200, "transition": "smooth" },
        { "expression": "inquiry", "holdMs": 300, "transitionMs": 180, "transition": "snappy" }
      ],
      "blink": {
        "enabled": true,
        "initialDelayMs": 800,
        "minIntervalMs": 2000,
        "maxIntervalMs": 4000,
        "durationMs": 120
      },
      "metadata": { "label": "Socrates Socratic Dialogue", "group": "interaction" }
    },
    "inquiry": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "inquiry", "holdMs": 1600, "transitionMs": 400, "transition": "snappy" },
        { "expression": "thinking", "holdMs": 1200, "transitionMs": 450, "transition": "smooth" }
      ],
      "blink": {
        "enabled": true,
        "initialDelayMs": 600,
        "minIntervalMs": 2000,
        "maxIntervalMs": 4000,
        "durationMs": 150
      },
      "metadata": { "label": "Socrates Inquisitive Scaffolding", "group": "interaction" }
    },
    "sleeping": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "sleeping", "holdMs": 4000, "transitionMs": 1000, "transition": "smooth" }
      ],
      "blink": {
        "enabled": false,
        "initialDelayMs": 0,
        "minIntervalMs": 3000,
        "maxIntervalMs": 6000,
        "durationMs": 200
      },
      "metadata": { "label": "Socrates Slumber / Recharging", "group": "sleep" }
    }
  },
  "animationOrder": ["idle", "thinking", "speaking", "inquiry", "sleeping"]
}
